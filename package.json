{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:sitemap": "tsx scripts/generate-sitemap.ts",
    "prerender": "tsx scripts/prerender-routes.ts",
    "clean": "knip",
    "clean:fix": "knip --fix",
    "clean:report": "knip --reporter markdown",
    "dcz": "tsx scripts/dead-code-guard.ts",
    "dcz:full": "tsx scripts/dead-code-guard.ts && tsc --noEmit && knip && vite build",
    "typecheck": "tsc --noEmit",
    "precommit": "tsx scripts/dead-code-guard.ts && tsc --noEmit && knip --no-exit-code && npm run build",
    "prepare": "husky",
    "postinstall": "node -e \"if(process.env.VERCEL!=='1'){require('child_process').execSync('npx puppeteer browsers install chrome',{stdio:'inherit'})}\"",
    "dev": "vite"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@heroui/theme": "^2.4.26",
    "@radix-ui/react-slot": "1.1.2",
    "@vercel/node": "^5.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "husky": "9.1.7",
    "knip": "5.85.0",
    "lint-staged": "16.2.7",
    "puppeteer": "24.36.1",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "4.1.12",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "tsx scripts/dead-code-guard.ts",
      "knip --no-exit-code"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
