  h1 { font-size: 22pt; color: #166534; border-bottom: 3px solid #22c55e; padding-bottom: 8pt; margin-top: 0; }
  h2 { font-size: 16pt; color: #166534; background-color: #f0fdf4; padding: 6pt 10pt; border-left: 4px solid #22c55e; margin-top: 24pt; page-break-after: avoid; }
  h3 { font-size: 13pt; color: #15803d; margin-top: 16pt; margin-bottom: 4pt; page-break-after: avoid; }
  h4 { font-size: 11pt; color: #166534; margin-top: 10pt; margin-bottom: 4pt; }
  table { border-collapse: collapse; width: 100%; margin: 8pt 0 16pt 0; font-size: 10pt; }
  th { background-color: #166534; color: white; padding: 6pt 8pt; text-align: left; font-weight: bold; border: 1px solid #166534; }
  td { padding: 5pt 8pt; border: 1px solid #d1d5db; vertical-align: top; }
  tr:nth-child(even) td { background-color: #f9fafb; }
  .fiche { border: 1px solid #d1d5db; padding: 10pt 14pt; margin: 10pt 0; background-color: #fafafa; page-break-inside: avoid; }
  .fiche-titre { font-size: 12pt; font-weight: bold; color: #166534; margin-bottom: 6pt; border-bottom: 1px solid #e5e7eb; padding-bottom: 4pt; }
  .champ { margin: 4pt 0; }
  .champ b { color: #374151; display: inline-block; width: 120pt; }
  .ligne-vide { border-bottom: 1px dotted #9ca3af; display: inline-block; width: 250pt; margin-left: 4pt; }
  .tag-mock { background-color: #fef3c7; color: #92400e; padding: 1pt 6pt; font-size: 9pt; font-weight: bold; }
  .tag-client { background-color: #d1fae5; color: #065f46; padding: 1pt 6pt; font-size: 9pt; font-weight: bold; }
  .tag-shooting { background-color: #dbeafe; color: #1e40af; padding: 1pt 6pt; font-size: 9pt; font-weight: bold; }
  .important { background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 6pt 10pt; margin: 8pt 0; font-size: 10pt; }
  .conseil { background-color: #eff6ff; border-left: 4px solid #3b82f6; padding: 6pt 10pt; margin: 8pt 0; font-size: 10pt; }
  .recap-box { border: 2px solid #166534; padding: 10pt; margin: 12pt 0; background-color: #f0fdf4; }
  .page-break { page-break-before: always; }
  .notes-zone { border: 1px solid #d1d5db; min-height: 100pt; padding: 8pt; margin-top: 6pt; background-color: #fff; }
</style>
